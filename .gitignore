# Ignore contents of the plugin dir, as this contains other repos, and we don't want to include them as submodules.
zsh/.config/zsh/plugins/*
zsh/.config/zsh/.histfile
zsh/.config/zsh/.zcompdump

# Ignore GitHub-specific files (Copilot instructions, workflows, etc.) — not part of the stow packages.
.github/

# Ignore log files
*.log
*/*.log

# Ignore some things I don't want getting pulled down on my work computer, find them in the NSFW branch
*pinup.*
*/*pinup.*
*pinup*

