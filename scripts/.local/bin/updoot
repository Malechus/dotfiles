#!/bin/sh

update_mac(){
	echo "updating homebrew packages"
	brew update && brew upgrade
}

update_arch(){
	echo "Updating pacman packages"
	sudo pacman -Syu	
}

update_ubuntu(){
	echo "Updating apt packages"
	sudo apt update && sudo apt upgrade -y
}

FSyH=false
autoSug=false
zhss=false

echo "Updating dotfiles"
cd ~/dotfiles 
git fetch
git pull

cd $ZDOTDIR/plugins/ 

for rdir in */; do
	echo "Updating $rdir"
	cd $rdir
	case $rdir in
		"F-Sy-H")
			$FSyH=true
			;;
		"zsh-autosuggestions")
			$autoSug=true
			;;
		"zsh-history-substring-search")
			$zhss=true
			;;
	esac
	git fetch
	git pull
	cd ..
done

if ["$FSyH" = false]; then
	echo "F-S-H not found, fetching."
	git clone "https://github.com/z-shell/F-Sy-H.git"
fi

if ["$autoSug" = false]; then
	echo "autosuggestions not found, fetching."
	git clone "https://github.com/zsh-users/zsh-autosuggestions"
fi

if ["$zhss" = false]; then
	echo "substring search not found, fetching."
	git clone "https://github.com/zsh-users/zsh-history-substring-search"
fi

case $OSTYPE in
	"linux-gnu")
		case $(lsb_release -i | cut -f 2-) in
			Arch)
				update_arch
				;;
			Ubuntu)
				update_ubuntu
				;;
		esac
		;;
	darwin*)
		update_mac
		;;
esac


